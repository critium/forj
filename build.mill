package build

import mill.*
import mill.api.BuildCtx
import mill.javalib.*
import mill.javalib.publish.*

/**
 * Every module compiles, tests and runs on the pinned JDK (fetched by bin/fetch-jdk), with
 * Java preview features on: the plugin is tied to javac internals, and forj.Par uses
 * StructuredTaskScope, a preview API in JDK 27/28.
 *
 * .jdk/preview is that JDK with a `java` launcher that always adds --enable-preview, so every
 * JVM Mill starts (compiler, tests, test discovery, runMain) has preview on, including ones
 * Mill doesn't let us pass flags to.
 */
trait PinnedJdk extends JavaModule {
  def javaHome = Task.Input {
    val home = BuildCtx.workspaceRoot / ".jdk" / "preview"
    if (!os.exists(home / "bin" / "javac")) sys.error("missing pinned JDK: run bin/fetch-jdk")
    Some(PathRef(home, quick = true))
  }
}

/** Appends `flags` unless already there (test modules inherit their parent's javacOptions). */
def withFlags(options: Seq[String], flags: Seq[String]): Seq[String] =
  if (options.containsSlice(flags)) options else options ++ flags

trait ForjJava extends MavenModule with PinnedJdk {
  def javacOptions = withFlags(super.javacOptions(), Seq("--enable-preview", "--source", "28"))
  // the published -javadoc jar is built from the same sources, so javadoc needs the same flags
  def javadocOptions = super.javadocOptions() ++ Seq("--enable-preview", "--source", "28", "-Xdoclint:none")
}

/**
 * Published as forj:forj-<name> (./mill __.publishM2Local for ~/.m2). The class files are
 * preview class files for the pinned JDK, so consumers need the same JDK and --enable-preview.
 */
trait ForjPublish extends PublishModule {
  def publishVersion = "0.1.0-SNAPSHOT"
  def pomSettings = PomSettings(
    description = "forj: Scala features for Java, as a javac plugin",
    organization = "forj",
    url = "",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl(),
    developers = Seq()
  )
}

/** JUnit 5 tests; compiler options come from the enclosing module. */
trait ForjTests extends PinnedJdk with TestModule.Junit5 {
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.junit.jupiter:junit-jupiter:5.13.4",
    mvn"org.junit.platform:junit-platform-launcher:1.13.4"
  )
}

/** javac internals the plugin compiles against. */
val javacInternals = Seq("api", "code", "comp", "main", "parser", "tree", "util")
  .map(p => s"--add-exports=jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")

/** JVM flags for any JVM that runs javac with the plugin: it also swaps javac's parser factory. */
val pluginJvmOptions = javacInternals ++ Seq("comp", "main", "util")
  .map(p => s"--add-opens=jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")

/** Runtime API: the JDK monad instances and Par. No dependencies. */
object core extends ForjJava with ForjPublish {
  def artifactName = "forj-core"

  object test extends MavenTests with ForjTests
}

/** The javac plugin that desugars comprehensions. */
object plugin extends ForjJava with ForjPublish {
  def artifactName = "forj-plugin"

  def javacOptions = super.javacOptions() ++ javacInternals
  def javadocOptions = super.javadocOptions() ++ javacInternals
  def jvmOptions = super.jvmOptions() ++ pluginJvmOptions

  object test extends MavenTests with ForjTests {
    def moduleDeps = super.moduleDeps ++ Seq(core)
    def javacOptions = super.javacOptions() ++ javacInternals
    def forkArgs = super.forkArgs() ++ pluginJvmOptions
  }
}

/** Mix into any module whose sources use for comprehensions. */
trait ForjModule extends ForjJava {
  /** Print each rewritten comprehension during compilation. */
  def forjDebug: T[Boolean] = false

  def moduleDeps = super.moduleDeps ++ Seq(core)

  // Mill launches the compiler JVM with these options, and that is where the plugin gets loaded
  def jvmOptions = super.jvmOptions() ++ pluginJvmOptions

  // On the compile classpath (not -processorpath) so javac finds it next to other
  // plugins, such as the semanticdb plugin Metals relies on. Compile-time only.
  def compileModuleDeps = super.compileModuleDeps ++ Seq(plugin)
  // ...plus its META-INF/services entry, which Mill leaves off compile classpaths
  def compileResources = super.compileResources() ++ plugin.resources()

  def javacOptions = Task {
    withFlags(super.javacOptions(), Seq(if (forjDebug()) "-Xplugin:Forj debug" else "-Xplugin:Forj"))
  }
}

object examples extends ForjModule {
  object test extends MavenTests with ForjModule with ForjTests
}

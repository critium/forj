#!/usr/bin/env bash
# Checks the published artifacts the way a downstream build uses them: a throw-away Mill
# project that depends on forj-core and puts forj-plugin on the compile classpath, both from
# ~/.m2, compiles a program using forj syntax with -Xplugin:Forj, runs it, and builds its
# javadoc jar.
#
# Run ./mill __.publishM2Local first. The build below is the downstream recipe libraries copy.
set -euo pipefail
FORJ="$(cd "$(dirname "$0")/.." && pwd -P)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

cp "$FORJ/mill" "$FORJ/.mill-version" "$WORK/"
mkdir -p "$WORK/app/src/app"

cat > "$WORK/build.mill" <<EOF
package build

import mill.*
import mill.javalib.*

/** javac internals the forj plugin uses: the compiler JVM needs them exported and opened. */
val forjCompilerJvmOptions =
  Seq("api", "code", "comp", "main", "parser", "tree", "util")
    .map(p => s"--add-exports=jdk.compiler/com.sun.tools.javac.\$p=ALL-UNNAMED") ++
  Seq("comp", "main", "util")
    .map(p => s"--add-opens=jdk.compiler/com.sun.tools.javac.\$p=ALL-UNNAMED")

/** What a module whose sources use forj syntax mixes in. */
trait ForjModule extends JavaModule {
  // forj's class files are preview class files for this exact JDK
  def javaHome = Task.Input { Some(PathRef(os.Path("$FORJ/.jdk/preview"), quick = true)) }
  def repositories = super.repositories() ++ Seq("m2Local")
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"forj:forj-core:0.1.0-SNAPSHOT")
  def compileMvnDeps = super.compileMvnDeps() ++ Seq(mvn"forj:forj-plugin:0.1.0-SNAPSHOT")
  def jvmOptions = super.jvmOptions() ++ forjCompilerJvmOptions
  def javacOptions = super.javacOptions() ++ Seq("--enable-preview", "--source", "28", "-Xplugin:Forj")
  // With annotation processors (JMH, Lombok, ...), javac loads plugins from the processor
  // path only, not the classpath, so the forj plugin goes there too (otherwise:
  // "plug-in not found: Forj").
  def annotationProcessorsResolvedMvnDeps = Task {
    val processors = super.annotationProcessorsResolvedMvnDeps()
    if (processors.isEmpty) processors
    else processors ++ compileClasspath().filter(_.path.last.startsWith("forj-plugin-"))
  }
  // javadoc parses sources without the plugin, so it reads them as the plugin's text stage
  // rewrites them (F<A> as forj.Kind<F, A>, using clauses as @forj.Using parameters)
  def forjExportedSources = Task {
    val plugin = compileClasspath().filter(_.path.last.startsWith("forj-plugin-")).map(_.path)
    os.proc(
      javaHome().get.path / "bin" / "java", forjCompilerJvmOptions,
      "-cp", plugin.mkString(java.io.File.pathSeparator),
      "forj.plugin.ExportSources", Task.dest, allSources().map(_.path)
    ).call(stdout = os.Inherit)
    PathRef(Task.dest)
  }
  def docSources = Task { Seq(forjExportedSources()) }
  // forj-core holds preview class files (IO, For, ...), which javadoc reads only with preview on
  def javadocOptions = super.javadocOptions() ++ Seq("--enable-preview", "--source", "28")
}

object app extends ForjModule

/** forj syntax next to an annotation processor (JMH's), which once kept the plugin from loading. */
object withProcessor extends ForjModule {
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.openjdk.jmh:jmh-core:1.37")
  def annotationProcessorsMvnDeps = Seq(mvn"org.openjdk.jmh:jmh-generator-annprocess:1.37")
}
EOF

cat > "$WORK/app/src/app/Show.java" <<'EOF'
package app;

public interface Show<A> {
    String show(A a);

    given Show<Integer> integer = i -> "#" + i;

    extension <A> String show(A a)(using Show<A> s) {
        return s.show(a);
    }
}
EOF

cat > "$WORK/app/src/app/Main.java" <<'EOF'
package app;

import static app.Show.*;

import java.util.Optional;

/** Shows values twice: see {@link #twice(Object)}. */
public class Main {
    /** Shows {@code a} twice, with the {@link Show} in scope. */
    public static <A> String twice(A a)(using Show<A> s) {
        return a.show() + a.show();
    }

    /** Lifts one into any {@code F}; {@link #io()} is the same in {@code IO}. */
    public static <F<_>> F<Integer> one()(using forj.typeclass.Applicative<F> ap) {
        return ap.pure(1);
    }

    /** forj.effect.IO is a preview class file, which javadoc only reads with --enable-preview. */
    public static forj.effect.IO<Integer> io() {
        return forj.effect.IO.pure(1);
    }

    public static void main(String[] args) {
        Optional<Integer> sum = forj {
            x <- Optional.of(1);
            y <- Optional.of(2);
        } yield x + y;
        Integer n = 7;
        System.out.println(s"sum=${sum.get()} shown=${n.show()} twice=${twice(3)} combined=${n.combine(5)}");
    }
}
EOF

mkdir -p "$WORK/withProcessor/src/bench"
cat > "$WORK/withProcessor/src/bench/Bench.java" <<'JAVA'
package bench;

import org.openjdk.jmh.annotations.Benchmark;

public class Bench {
    interface Show<A> {
        String show(A a);
    }

    given Show<Integer> integer = i -> "#" + i;

    @Benchmark
    public String show() {
        return integer.show(1);
    }
}
JAVA

expected="sum=3 shown=#7 twice=#3#3 combined=12"
cd "$WORK"
if ! output="$(./mill --no-server app.run 2>&1)"; then
  echo "$output"
  echo "check-publish: downstream build failed" >&2
  exit 1
fi
if ! grep -qxF "$expected" <<<"$output"; then
  echo "$output"
  echo "check-publish: expected '$expected'" >&2
  exit 1
fi
if ! output="$(./mill --no-server withProcessor.compile 2>&1)"; then
  echo "$output"
  echo "check-publish: forj syntax next to an annotation processor failed to compile" >&2
  exit 1
fi
if [ ! -f out/withProcessor/compile.dest/classes/META-INF/BenchmarkList ]; then
  echo "check-publish: JMH's annotation processor didn't run" >&2
  exit 1
fi
if ! output="$(./mill --no-server app.docJar 2>&1)"; then
  echo "$output"
  echo "check-publish: javadoc of forj sources failed" >&2
  exit 1
fi
listing="$(unzip -l out/app/docJar.dest/out.jar)"   # not piped into grep -q: SIGPIPE under pipefail
if ! grep -qF "app/Main.html" <<<"$listing"; then
  echo "check-publish: the javadoc jar has no page for app.Main" >&2
  exit 1
fi
echo "check-publish: ok ($expected; also compiles next to an annotation processor; javadoc builds)"
